
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Todo App</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="min-h-screen bg-gray-100 text-gray-900">

    <main class="mx-auto flex min-h-screen w-full max-w-2xl flex-col px-4 py-12">
        <h1 class="mb-8 text-center text-3xl font-bold">My Todos</h1>

        <div class="flex-1 space-y-3 pb-28">
            <% if (todos && todos.length > 0) { %>
                <% todos.forEach(todo => { %>
                    <div class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
                       <form action="/todo/<%= todo.id %>" method="POST">
                            <button type="submit" class="text-lg <%= todo.isCompleted ? 'text-green-600' : 'text-gray-400' %>">
                                <i class="bi <%= todo.isCompleted ? 'bi-check-circle-fill' : 'bi-circle' %>"></i>
                            </button>
                        </form>
                        <span class="flex-1 break-words <%= todo.isCompleted ? 'text-gray-400 line-through' : 'text-gray-800' %>">
                            <%= todo.title %>
                        </span>
                        <form action="/todo/<%= todo.id %>/delete" method="POST">
                            <button type="submit" class="text-red-500 hover:text-red-700">
                                <i class="bi bi-trash3 text-lg"></i>
                            </button>
                        </form>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="py-12 text-center text-gray-500">
                    No todos yet. Add your first task!
                </p>
            <% } %>
        </div>

        <form
            action="/todo"
            method="POST"
            class="fixed bottom-6 left-1/2 flex w-[calc(100%-2rem)] max-w-2xl -translate-x-1/2 gap-3 rounded-2xl border border-gray-200 bg-white p-3 shadow-lg"
        >
            <input
                type="text"
                name="title"
                placeholder="What needs to be done?"
                required
                autofocus
                autocomplete="off"
                class="min-w-0 flex-1 rounded-xl border border-gray-200 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
            >

            <button
                type="submit"
                class="rounded-xl bg-blue-600 px-5 py-3 font-medium text-white transition hover:bg-blue-700"
            >
                Add
            </button>
        </form>
    </main>

</body>
</html>
